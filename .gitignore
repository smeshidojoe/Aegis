build/
dist/

# Inno Setup
installer_output/
Output/

# Папка самообновления создаётся рядом с exe, в разработке — в корне проекта.
_update/

# --- Данные программы -------------------------------------------------------- #
# База и копии живут в %APPDATA%\Aegis, сюда попасть не должны ни в каком виде —
# даже зашифрованные. Экспорт в CSV — открытым текстом, его тем более.
*.aegis
*.aegis.tmp
aegis-export*.csv
*.log
config.json

