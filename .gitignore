*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Окружения
.venv/
venv/
env/
ENV/

# Кеши инструментов
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Сборка ----------------------------------------------------------------- #
